# SPA + proxy da API na MESMA origem: o cookie de sessao (httpOnly, SameSite=Lax)
# so funciona sem CORS se o navegador ve UI e API no mesmo host.
server {
  listen 8080;
  root /usr/share/nginx/html;
  client_max_body_size 30m;

  location /api/ {
    proxy_pass ${API_PROXY_TARGET};
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # SSE do trace: com buffer o navegador recebe os spans todos de uma vez no
    # fim da execucao, e o "ao vivo" do simulador vira so um spinner.
    proxy_buffering off;
    proxy_cache off;
    proxy_read_timeout 600s;
  }

  location / {
    try_files $uri /index.html;
  }
}
