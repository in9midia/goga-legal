# Studio API — copie para .env (o .env não entra no git).
DATABASE_URL=postgres://studio:studio@localhost:5442/studio
PORT=8787
# Cifra das chaves de API dos provedores (AES-256-GCM). openssl rand -hex 32
# Trocar este valor torna ilegíveis as chaves já gravadas.
STUDIO_SECRET_KEY=
# Assina o cookie de sessão. openssl rand -hex 32
STUDIO_SESSION_SECRET=
# Admin criado no primeiro boot (só se não existir nenhum usuário).
STUDIO_ADMIN_EMAIL=admin@goga.local
STUDIO_ADMIN_PASSWORD=
# Chaves usadas só no primeiro boot, para semear os provedores.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# KB (Python) — no cluster: http://kb-api.stack-knowledge-base:8000
KB_URL=http://localhost:8890
KB_UI_URL=http://localhost:8890
# Onde ficam anexos e documentos gerados.
STUDIO_FILES_DIR=./data/files
