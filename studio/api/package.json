{
  "name": "goga-studio-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "eval": "tsx --env-file-if-exists=.env src/cli/eval.ts"
  },
  "dependencies": {
    "@ai-sdk/deepseek": "^3.0.50",
    "@ai-sdk/google": "^4.0.77",
    "@ai-sdk/openai-compatible": "^3.0.53",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.2",
    "@fastify/session": "^11.1.3",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.111",
    "argon2": "^0.45.1",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "mammoth": "^1.12.3",
    "pdf-parse": "^2.4.5",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.0.1"
  }
}
