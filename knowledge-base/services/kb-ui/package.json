{
  "name": "kb-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3010",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 3010",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{json,cjs,js,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{json,cjs,js,ts}\"",
    "test": "vitest run",
    "quality": "npm run format:check && tsc -b && npm run test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.0",
    "axios": "^1.7.7",
    "docx-preview": "^0.3.5",
    "keycloak-js": "^25.0.0",
    "lucide-react": "^0.454.0",
    "pdfjs-dist": "^4.7.76",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "three": "^0.186.0",
    "vis-network": "^10.1.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.8"
  }
}
