# Goga Legal — ambiente local (./start-k8s-local.sh). Copie para .env.
# O .env NÃO entra no git.

# Chaves de provedor. DeepSeek: chat dos agentes (Studio) e derivação de
# conceitos (KB). Gemini: embeddings da KB e visão para anexos escaneados.
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Studio. Deixe vazio para o deploy gerar (e reaproveitar nos próximos).
# ⚠ Trocar STUDIO_SECRET_KEY depois torna ilegíveis as chaves já cadastradas.
STUDIO_SECRET_KEY=
STUDIO_SESSION_SECRET=
STUDIO_ADMIN_EMAIL=admin@goga.local
STUDIO_ADMIN_PASSWORD=

# KB: off = sem Keycloak (MVP, só rede local). on = Keycloak do Goga.
KB_AUTH=off
